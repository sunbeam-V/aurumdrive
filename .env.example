# MySQL 8 / managed MySQL-compatible database
DATABASE_URL=mysql://aurum:change-me@db:3306/aurum
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used only by `pnpm admin:create`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Set after attaching the production domain; omit in Preview
NEXT_PUBLIC_SITE_URL=
# Optional; scripts stay disabled when empty or before consent
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
